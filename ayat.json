[
 {"text":"أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ","ref":"سورة الرعد - الآية 28","surah":"الرعد"},
 {"text":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ۝ إِنَّ مَعَ الْعُسْرِ يُسْرًا","ref":"سورة الشرح - الآيتان 5-6","surah":"الشرح"},
 {"text":"وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ","ref":"سورة الطلاق - الآية 3","surah":"الطلاق"},
 {"text":"لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا","ref":"سورة البقرة - الآية 286","surah":"البقرة"},
 {"text":"فَاذْكُرُونِي أَذْكُرْكُمْ","ref":"سورة البقرة - الآية 152","surah":"البقرة"},
 {"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ","ref":"سورة الضحى - الآية 5","surah":"الضحى"},
 {"text":"إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","ref":"سورة البقرة - الآية 153","surah":"البقرة"},
 {"text":"وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ","ref":"سورة الحديد - الآية 4","surah":"الحديد"},
 {"text":"رَبِّ اشْرَحْ لِي صَدْرِي ۝ وَيَسِّرْ لِي أَمْرِي","ref":"سورة طه - الآيتان 25-26","surah":"طه"},
 {"text":"وَقُل رَّبِّ زِدْنِي عِلْمًا","ref":"سورة طه - الآية 114","surah":"طه"},
 {"text":"حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ","ref":"سورة آل عمران - الآية 173","surah":"آل عمران"},
 {"text":"وَاصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ","ref":"سورة هود - الآية 115","surah":"هود"},
 {"text":"إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِّنَ الْمُحْسِنِينَ","ref":"سورة الأعراف - الآية 56","surah":"الأعراف"},
 {"text":"وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ","ref":"سورة الأعراف - الآية 156","surah":"الأعراف"},
 {"text":"قُلْ هُوَ اللَّهُ أَحَدٌ ۝ اللَّهُ الصَّمَدُ","ref":"سورة الإخلاص - الآيتان 1-2","surah":"الإخلاص"},
 {"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ","ref":"سورة ق - الآية 16","surah":"ق"},
 {"text":"وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ","ref":"سورة البقرة - الآية 186","surah":"البقرة"},
 {"text":"لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا","ref":"سورة التوبة - الآية 40","surah":"التوبة"}
]
