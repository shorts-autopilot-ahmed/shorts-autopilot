 "items": [
  {
   "text": "مَن جَدَّ وَجَدَ، وَمَن زَرَعَ حَصَدَ",
   "sub": "حكمة عربية",
   "tag": "الاجتهاد"
  },
  {
   "text": "العِلمُ في الصِّغَرِ كَالنَّقشِ على الحَجَرِ",
   "sub": "حكمة عربية",
   "tag": "العلم"
  },
  {
   "text": "الصَّبرُ مِفتاحُ الفَرَج",
   "sub": "حكمة عربية",
   "tag": "الصبر"
  },
  {
   "text": "خَيرُ الكَلامِ ما قَلَّ وَدَلَّ",
   "sub": "حكمة عربية",
   "tag": "الكلام"
  },
  {
   "text": "لا تُؤَجِّل عَمَلَ اليَومِ إلى الغَد",
   "sub": "حكمة عربية",
   "tag": "العمل"
  },
  {
   "text": "الوَقتُ كَالسَّيفِ إِن لَم تَقطَعهُ قَطَعَك",
   "sub": "حكمة عربية",
   "tag": "الوقت"
  },
  {
   "text": "الصاحِبُ سَاحِب",
   "sub": "حكمة عربية",
   "tag": "الصحبة"
  },
  {
   "text": "القَناعَةُ كَنزٌ لا يَفنَى",
   "sub": "حكمة عربية",
   "tag": "القناعة"
  },
  {
   "text": "مَن صَبَرَ ظَفِر",
   "sub": "حكمة عربية",
   "tag": "الصبر"
  },
  {
   "text": "رُبَّ كَلِمَةٍ قالَت لِصاحِبِها دَعني",
   "sub": "حكمة عربية",
   "tag": "اللسان"
  },
  {
   "text": "اطلُبوا العِلمَ مِنَ المَهدِ إلى اللَّحد",
   "sub": "حكمة عربية",
   "tag": "العلم"
  },
  {
   "text": "إِذا هَبَّت رِياحُكَ فَاغتَنِمها",
   "sub": "حكمة عربية",
   "tag": "الفرصة"
  }
 ]
}