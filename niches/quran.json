 "hashtags": "#قرآن #أذكار",
 "items": [
  {
   "text": "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ",
   "sub": "سورة الرعد - الآية 28",
   "tag": "الرعد"
  },
  {
   "text": "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ۝ إِنَّ مَعَ الْعُسْرِ يُسْرًا",
   "sub": "سورة الشرح - الآيتان 5-6",
   "tag": "الشرح"
  },
  {
   "text": "وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ",
   "sub": "سورة الطلاق - الآية 3",
   "tag": "الطلاق"
  },
  {
   "text": "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا",
   "sub": "سورة البقرة - الآية 286",
   "tag": "البقرة"
  },
  {
   "text": "فَاذْكُرُونِي أَذْكُرْكُمْ",
   "sub": "سورة البقرة - الآية 152",
   "tag": "البقرة"
  },
  {
   "text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ",
   "sub": "سورة الضحى - الآية 5",
   "tag": "الضحى"
  },
  {
   "text": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
   "sub": "سورة البقرة - الآية 153",
   "tag": "البقرة"
  },
  {
   "text": "وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ",
   "sub": "سورة الحديد - الآية 4",
   "tag": "الحديد"
  },
  {
   "text": "رَبِّ اشْرَحْ لِي صَدْرِي ۝ وَيَسِّرْ لِي أَمْرِي",
   "sub": "سورة طه - الآيتان 25-26",
   "tag": "طه"
  },
  {
   "text": "وَقُل رَّبِّ زِدْنِي عِلْمًا",
   "sub": "سورة طه - الآية 114",
   "tag": "طه"
  },
  {
   "text": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ",
   "sub": "سورة آل عمران - الآية 173",
   "tag": "آل عمران"
  },
  {
   "text": "وَاصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ",
   "sub": "سورة هود - الآية 115",
   "tag": "هود"
  },
  {
   "text": "إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِّنَ الْمُحْسِنِينَ",
   "sub": "سورة الأعراف - الآية 56",
   "tag": "الأعراف"
  },
  {
   "text": "وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ",
   "sub": "سورة الأعراف - الآية 156",
   "tag": "الأعراف"
  },
  {
   "text": "قُلْ هُوَ اللَّهُ أَحَدٌ ۝ اللَّهُ الصَّمَدُ",
   "sub": "سورة الإخلاص - الآيتان 1-2",
   "tag": "الإخلاص"
  },
  {
   "text": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ",
   "sub": "سورة ق - الآية 16",
   "tag": "ق"
  },
  {
   "text": "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ",
   "sub": "سورة البقرة - الآية 186",
   "tag": "البقرة"
  },
  {
   "text": "لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا",
   "sub": "سورة التوبة - الآية 40",
   "tag": "التوبة"
  }
 ]
}